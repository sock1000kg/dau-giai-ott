# Copy to a private file with mode 0600. This config contains paths and
# schedule metadata only; never put account passwords or tokens here.
REPO_ROOT=/opt/ott/releases/0123456789abcdef0123456789abcdef01234567
OTT_DEMO_PROJECT=ott-demo-reset
OTT_DEMO_ENV_FILE=/opt/ott/.local/demo-reset/demo.env
OTT_DEMO_COMPOSE_FILE=/opt/ott/releases/0123456789abcdef0123456789abcdef01234567/infra/local/compose.yaml
OTT_DEMO_SNAPSHOT_BUNDLE=/opt/ott/.local/demo-reset/baseline
OTT_DEMO_RESET_LOG=/opt/ott/.local/demo-reset/reset.log
OTT_DEMO_RESET_CRON=0 * * * *
OTT_DEMO_RESET_TIMEZONE=Asia/Ho_Chi_Minh

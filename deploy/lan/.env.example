# ==============================================================================
# OTT TOURNAMENT FINALS — ISOLATED LAN ENVIRONMENT TEMPLATE (P3-N07)
# Single-server offline setup (lab server without Internet access)
# Copy to deploy/lan/.env before launching: cp deploy/lan/.env.example deploy/lan/.env
# ==============================================================================

# Deployment mode (Enforces strict finals offline security startup guards)
OTT_DEPLOYMENT_MODE=finals_lan

# Network Security & Admin Ingress Guards (AC-23)
# Subnet mask of BTC administration laptops on the tournament LAN switch
OTT_ADMIN_NETWORK_ALLOWLIST=192.168.100.0/24,127.0.0.1/32
# Reverse proxy / gateway IPs trusted to forward client IP headers
OTT_TRUSTED_PROXIES=127.0.0.1,192.168.100.1

# Session & Authentication Secrets (Generate 32-character random hex keys)
# openssl rand -hex 32
OTT_SESSION_SECRET=change_me_to_32_byte_random_session_secret_for_finals_lan
# Base32 TOTP secret for BTC Administrator MFA bootstrap (RFC 6238)
OTT_BOOTSTRAP_BTC_TOTP_SECRET=JBSWY3DPEHPK3PXPJBSWY3DPEHPK3PXP

# Database Configuration (PostgreSQL 16)
POSTGRES_DB=ott_finals
POSTGRES_USER=ott_admin
POSTGRES_PASSWORD=change_me_to_strong_db_password_for_finals_lan

# Message Queue & State Store (Redis 7)
REDIS_PASSWORD=change_me_to_strong_redis_password_for_finals_lan

# S3-Compatible Storage Configuration (SeaweedFS / MinIO)
S3_BUCKET=ott-finals-artifacts
S3_ACCESS_KEY_ID=ott_lan_s3_admin
S3_SECRET_ACCESS_KEY=change_me_to_strong_s3_secret_for_finals_lan

# Service Bindings (Participant LAN facing)
PORT=3000
WEB_PORT=80
API_BIND_IP=0.0.0.0
WEB_BIND_IP=0.0.0.0

# Worker Capacity Policy in Offline Finals
# Max concurrency matches lab server physical core count (default: 4)
WORKER_MAX_CONCURRENCY=4
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TTL_SECONDS=15


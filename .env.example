# ==============================================================================
# OTT TOURNAMENT PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting services: cp .env.example .env
# Never commit .env to source control.
#
# Safe placeholders are provided for local development with infra/local/compose.yaml.
#
# NOTE ON LAN COMPOSE DRIFT (deploy/lan/compose.yml / deploy/lan/.env.example):
# The LAN compose template contains variable drift that will be reconciled in the
# upcoming Compose task. The canonical variable names recognized by the API runtime are:
#   - OTT_DEPLOYMENT_MODE: must be one of 'dev', 'test', 'hosted', 'production'
#     (deploy/lan uses 'finals_lan' which is not valid).
#   - OTT_ADMIN_ALLOWLIST: comma-separated CIDRs (deploy/lan uses OTT_ADMIN_NETWORK_ALLOWLIST).
#   - HOST: binding address (deploy/lan uses API_BIND_IP).
#   - DATABASE_URL / REDIS_URL: required connection strings (deploy/lan only specifies ports/passwords).
#   - OTT_SESSION_SECRET: unused; session state is managed via Redis session store.
#   - OTT_TOTP_ENCRYPTION_KEY: 32-byte base64 encryption key required whenever TOTP is enabled.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Compose Services (infra/local/compose.yaml)
# ------------------------------------------------------------------------------
POSTGRES_DB=ott_local
POSTGRES_USER=ott_local
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

S3_ACCESS_KEY_ID=ott-local-admin
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET
S3_BUCKET=ott-submissions
S3_API_PORT=8333

# ------------------------------------------------------------------------------
# 2. API Runtime Connection Strings (Required)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://ott_local:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:5432/ott_local
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
# SeaweedFS / MinIO local dev uses path-style addressing; API runtime uses forcePathStyle: true
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 3. HTTP Server Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
OTT_RUN_MIGRATIONS=false
OTT_SHUTDOWN_TIMEOUT_MS=10000
# Name of the BullMQ match queue (must match the worker: ott.match.v1)
OTT_MATCH_QUEUE=ott.match.v1

# ------------------------------------------------------------------------------
# 4. Security & Deployment Mode (Required: dev | test | hosted | production)
# ------------------------------------------------------------------------------
OTT_DEPLOYMENT_MODE=dev
OTT_SECURE_COOKIES=false

# In hosted or production mode, the following security guards are enforced at startup:
#   - OTT_ADMIN_TOTP_REQUIRED must be true
#   - OTT_ADMIN_ALLOWLIST must be set and not empty (e.g., 127.0.0.1/32,192.168.100.0/24)
#   - OTT_TRUSTED_PROXIES must be configured or literal "none" (cannot be 0.0.0.0/0)
#   - OTT_TOTP_ENCRYPTION_KEY must be a 32-byte base64 encoded string
OTT_ADMIN_TOTP_REQUIRED=false
OTT_ADMIN_ALLOWLIST=
OTT_TRUSTED_PROXIES=none
OTT_TOTP_ENCRYPTION_KEY=

# Rate Limiting (Requests per minute)
OTT_WRITE_RATE_LIMIT_IP=600
OTT_WRITE_RATE_LIMIT_ACCOUNT=300

# ------------------------------------------------------------------------------
# 5. Bootstrap BTC Administrator Account (Optional)
# ------------------------------------------------------------------------------
# If both username and password are provided, the API runtime bootstraps the
# account idempotently on startup.
OTT_BOOTSTRAP_BTC_USERNAME=admin
OTT_BOOTSTRAP_BTC_PASSWORD=CHANGE_ME_BTC_PASSWORD
# Optional Base32 TOTP secret for the initial BTC admin (e.g. RFC 6238)
OTT_BOOTSTRAP_BTC_TOTP_SECRET=

# Phase 1 does not read environment configuration: use the MatchRunner CLI flags.
#
# Phase 2 local services: copy to .env and replace every CHANGE_ME value with
# a unique local-only value before starting Docker Compose. Never commit .env.
# SeaweedFS is local S3-compatible storage. These credentials are development
# placeholders only; application code later reads its S3 configuration from env.
POSTGRES_DB=ott_local
POSTGRES_USER=ott_local
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

S3_ACCESS_KEY_ID=ott-local-admin
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET
S3_BUCKET=ott-submissions
S3_API_PORT=8333
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

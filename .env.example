# ==============================================================================
# OTT TOURNAMENT PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env before starting services: cp .env.example .env
# Never commit .env to source control.
#
# Safe placeholders are provided for local development with infra/local/compose.yaml.
#
# NOTE ON LAN COMPOSE DRIFT (deploy/lan/compose.yml / deploy/lan/.env.example):
# The LAN compose template contains variable drift that will be reconciled in the
# upcoming Compose task. The canonical variable names recognized by the API runtime are:
#   - OTT_DEPLOYMENT_MODE: must be one of 'dev', 'test', 'hosted', 'production'
#     (deploy/lan uses 'finals_lan' which is not valid).
#   - OTT_ADMIN_ALLOWLIST: comma-separated CIDRs (deploy/lan uses OTT_ADMIN_NETWORK_ALLOWLIST).
#   - HOST: binding address (deploy/lan uses API_BIND_IP).
#   - DATABASE_URL / REDIS_URL: required connection strings (deploy/lan only specifies ports/passwords).
#   - OTT_SESSION_SECRET: unused; session state is managed via Redis session store.
#   - OTT_TOTP_ENCRYPTION_KEY: 32-byte base64 encryption key required whenever TOTP is enabled.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Local Compose Services (infra/local/compose.yaml)
# ------------------------------------------------------------------------------
POSTGRES_DB=ott_local
POSTGRES_USER=ott_local
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_PORT=5432

REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_PORT=6379

S3_ACCESS_KEY_ID=ott-local-admin
S3_SECRET_ACCESS_KEY=CHANGE_ME_S3_SECRET
S3_BUCKET=ott-submissions
S3_API_PORT=8333

# Web gateway reverse proxy bind address and public port (${APP_BIND}:${APP_PORT})
# Default binds to all interfaces (0.0.0.0). Set to 127.0.0.1 for loopback only.
APP_BIND=0.0.0.0
APP_PORT=8080

# Host group ID for /var/run/docker.sock required by worker and coordinator
# to communicate with the Docker daemon as unprivileged user 'node' (UID 1000).
# On Linux host, run: stat -c %g /var/run/docker.sock
DOCKER_GID=

# Docker daemon socket path on host
DOCKER_SOCKET=/var/run/docker.sock

# ------------------------------------------------------------------------------
# 2. API Runtime Connection Strings (Required)
# ------------------------------------------------------------------------------
DATABASE_URL=postgres://ott_local:CHANGE_ME_POSTGRES_PASSWORD@127.0.0.1:5432/ott_local
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@127.0.0.1:6379
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
# SeaweedFS / MinIO local dev uses path-style addressing; API runtime uses forcePathStyle: true
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 3. HTTP Server Configuration
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
OTT_RUN_MIGRATIONS=false
OTT_SHUTDOWN_TIMEOUT_MS=10000
# Name of the BullMQ match queue (must match the worker: ott.match.v1)
OTT_MATCH_QUEUE=ott.match.v1

# ------------------------------------------------------------------------------
# 4. Security & Deployment Mode (Required: dev | test | hosted | production)
# ------------------------------------------------------------------------------
OTT_DEPLOYMENT_MODE=dev
OTT_SECURE_COOKIES=false
# Demo seeder mode (allowed only in 'dev' or 'test'; demo script flips to true)
OTT_DEMO_MODE=false
# Demo seeder account generation options (used when OTT_DEMO_MODE=true)
# Number of team accounts to seed (1..50, default 2; public demo mode uses 10)
OTT_DEMO_TEAM_COUNT=2
# Optional custom passwords for seeded demo accounts (default: ABC123)
OTT_DEMO_BTC_PASSWORD=
OTT_DEMO_TEAM_PASSWORD=

# In hosted or production mode, the following security guards are enforced at startup:
#   - OTT_ADMIN_TOTP_REQUIRED must be true
#   - OTT_ADMIN_ALLOWLIST must be set and not empty (e.g., 127.0.0.1/32,192.168.100.0/24)
#   - OTT_TRUSTED_PROXIES must be configured or literal "none" (cannot be 0.0.0.0/0)
#   - OTT_TOTP_ENCRYPTION_KEY must be a 32-byte base64 encoded string
OTT_ADMIN_TOTP_REQUIRED=false
OTT_ADMIN_ALLOWLIST=
OTT_TRUSTED_PROXIES=none
OTT_TOTP_ENCRYPTION_KEY=

# Rate Limiting (Requests per minute)
OTT_WRITE_RATE_LIMIT_IP=600
OTT_WRITE_RATE_LIMIT_ACCOUNT=300

# ------------------------------------------------------------------------------
# 5. Bootstrap BTC Administrator Account (Optional)
# ------------------------------------------------------------------------------
# If both username and password are provided, the API runtime bootstraps the
# account idempotently on startup.
OTT_BOOTSTRAP_BTC_USERNAME=btc
OTT_BOOTSTRAP_BTC_PASSWORD=CHANGE_ME_BTC_PASSWORD
# Optional Base32 TOTP secret for the initial BTC admin (e.g. RFC 6238)
OTT_BOOTSTRAP_BTC_TOTP_SECRET=

# ------------------------------------------------------------------------------
# 6. Worker Runtime Configuration (P3-D32)
# ------------------------------------------------------------------------------
# Queue name to consume (must equal the API's OTT_MATCH_QUEUE)
# OTT_MATCH_QUEUE=ott.match.v1
# Dead letter queue name for poisoned or terminal failed jobs
# OTT_DEAD_LETTER_QUEUE=ott.match.dead-letter.v1

# Optional persistent worker identifier (defaults to auto-generated worker-<uuid>)
# OTT_WORKER_ID=

# Concurrency bounds (D-26 PoC: 4 concurrent matches baseline)
OTT_WORKER_MAX_CONCURRENCY=4
OTT_WORKER_MIN_CONCURRENCY=1

# Heartbeat interval and TTL for worker discovery and liveness
OTT_WORKER_HEARTBEAT_MS=5000
OTT_WORKER_HEARTBEAT_TTL_SECONDS=15

# Metrics and health HTTP endpoint (INTERNAL ONLY - do NOT publish or expose to WAN)
OTT_WORKER_METRICS_HOST=127.0.0.1
OTT_WORKER_METRICS_PORT=9464

# Docker Engine socket (mounted into worker and coordinator containers; bot containers
# stay no-network, no-mount, no-socket per the sandbox security policy)
OTT_DOCKER_SOCKET=/var/run/docker.sock
OTT_WORKER_REQUIRE_DOCKER=true

# Graceful drain shutdown timeout in milliseconds (matches active drain limit)
# OTT_SHUTDOWN_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 7. Coordinator Runtime Configuration (P2-T32)
# ------------------------------------------------------------------------------
# NOTE: The coordinator is trusted worker-side code and is the only other process
# that may mount the Docker Engine socket (for preflight protocol verification).
# It MUST run as a SINGLE INSTANCE. Redundant instances stay in standby via
# PostgreSQL advisory lock (pg_try_advisory_lock(hashtext('ott:coordinator'))).
#
# Shared connection variables reused from sections 2 & 6:
#   DATABASE_URL, REDIS_URL, S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID,
#   S3_SECRET_ACCESS_KEY, S3_REGION, OTT_MATCH_QUEUE, OTT_DOCKER_SOCKET,
#   OTT_SHUTDOWN_TIMEOUT_MS.

# Preflight submission processing interval and concurrency batch size (1-8)
OTT_COORD_PREFLIGHT_INTERVAL_MS=2000
OTT_COORD_PREFLIGHT_BATCH=2

# Outbox match dispatch interval and batch limit
OTT_COORD_DISPATCH_INTERVAL_MS=1000
OTT_COORD_DISPATCH_LIMIT=100

# Series and round rating settlement check interval
OTT_COORD_SETTLE_INTERVAL_MS=5000

# Public qualification snapshot publish interval (0 disables) and retention keep count
OTT_COORD_SNAPSHOT_INTERVAL_MS=5000
OTT_SNAPSHOT_DIR=src/platform/web/public/snapshots
OTT_SNAPSHOT_KEEP=24

# Path to public editorial JSON file (re-read on every publish; defaults to /editorial/public.json in local compose)
# OTT_EDITORIAL_FILE=/editorial/public.json
# Host directory for public editorial content mounted read-only to /editorial in compose
# OTT_DEMO_EDITORIAL_HOST_DIR=.local/demo/editorial

# Layer and submission retention mode (off | dry-run) and interval
OTT_COORD_RETENTION=off
OTT_COORD_RETENTION_INTERVAL_MS=3600000

# Coordinator metrics and health HTTP endpoint (INTERNAL ONLY)
OTT_COORD_METRICS_HOST=127.0.0.1
OTT_COORD_METRICS_PORT=9465

# Enforce Docker availability for preflight sandbox execution
OTT_COORD_REQUIRE_DOCKER=true

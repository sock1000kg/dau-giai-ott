{
  "name": "ott-tournament",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "^22.12.0" },
  "workspaces": ["src/game-core", "src/bot-protocol", "src/match-runner", "src/platform/job-contract", "src/platform/api", "src/platform/worker", "src/platform/web", "src/bots/sandbox-corpus"],
  "scripts": {
    "start:api": "npm run start --workspace @ott/platform-api",
    "start:worker": "npm run start --workspace @ott/platform-worker",
    "start:coordinator": "npm run start:coordinator --workspace @ott/platform-worker",
    "db:migrate": "npm run db:migrate --workspace @ott/platform-api",
    "typecheck": "npm run typecheck --workspaces && tsc -p tsconfig.json",
    "test": "npm run test --workspaces && vitest run",
    "test:e2e:qualification": "bash scripts/run-local-qualification.sh",
    "demo:up": "bash scripts/demo.sh up",
    "demo:status": "bash scripts/demo.sh status",
    "demo:accounts": "bash scripts/demo.sh accounts",
    "demo:logs": "bash scripts/demo.sh logs",
    "demo:round": "bash scripts/demo.sh round",
    "demo:stop": "bash scripts/demo.sh stop",
    "demo:reset": "bash scripts/demo.sh reset",
    "build": "npm run build --workspaces"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}

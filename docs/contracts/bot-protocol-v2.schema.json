{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dau-giai-ott.local/schemas/bot-protocol-v2.schema.json",
  "title": "OTT Bot Protocol v2",
  "oneOf": [
    { "$ref": "#/$defs/initMessage" },
    { "$ref": "#/$defs/stateUpdateMessage" },
    { "$ref": "#/$defs/actionMessage" },
    { "$ref": "#/$defs/turnResultMessage" },
    { "$ref": "#/$defs/matchResultMessage" }
  ],
  "$defs": {
    "matchId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "pieceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "side": {
      "enum": ["X", "O"]
    },
    "pieceType": {
      "enum": ["ROCK", "PAPER", "SCISSORS"]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["col", "row"],
      "properties": {
        "col": { "type": "integer", "minimum": 0, "maximum": 8 },
        "row": { "type": "integer", "minimum": 0, "maximum": 8 }
      }
    },
    "piece": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "owner", "type", "position"],
      "properties": {
        "id": { "$ref": "#/$defs/pieceId" },
        "owner": { "$ref": "#/$defs/side" },
        "type": { "$ref": "#/$defs/pieceType" },
        "position": { "$ref": "#/$defs/position" }
      }
    },
    "gameAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pieceId", "to"],
      "properties": {
        "pieceId": { "$ref": "#/$defs/pieceId" },
        "to": { "$ref": "#/$defs/position" }
      }
    },
    "mapRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mapId", "version", "checksum"],
      "properties": {
        "mapId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1 },
        "checksum": { "$ref": "#/$defs/sha256" }
      }
    },
    "mapDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "mapId",
        "version",
        "width",
        "height",
        "obstacles",
        "spawns",
        "goals",
        "checksum"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "mapId": { "type": "string", "minLength": 1, "maxLength": 128 },
        "version": { "type": "integer", "minimum": 1 },
        "width": { "const": 9 },
        "height": { "const": 9 },
        "obstacles": {
          "type": "array",
          "maxItems": 81,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/position" }
        },
        "spawns": {
          "type": "array",
          "minItems": 18,
          "maxItems": 18,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/piece" }
        },
        "goals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["X", "O"],
          "properties": {
            "X": {
              "type": "object",
              "additionalProperties": false,
              "required": ["col", "row"],
              "properties": {
                "col": { "const": 8 },
                "row": { "const": 8 }
              }
            },
            "O": {
              "type": "object",
              "additionalProperties": false,
              "required": ["col", "row"],
              "properties": {
                "col": { "const": 0 },
                "row": { "const": 0 }
              }
            }
          }
        },
        "checksum": { "$ref": "#/$defs/sha256" }
      }
    },
    "publicGameState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "engineVersion",
        "map",
        "status",
        "turn",
        "turnNumber",
        "turnCount",
        "revision",
        "maxTurns",
        "pieces",
        "outcome"
      ],
      "properties": {
        "schemaVersion": { "const": 1 },
        "engineVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "map": { "$ref": "#/$defs/mapRef" },
        "status": { "const": "PLAYING" },
        "turn": { "$ref": "#/$defs/side" },
        "turnNumber": { "type": "integer", "minimum": 1 },
        "turnCount": { "type": "integer", "minimum": 0 },
        "revision": { "type": "integer", "minimum": 0 },
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "pieces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 18,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/piece" }
        },
        "outcome": { "type": "null" }
      }
    },
    "turnErrorCode": {
      "enum": [
        "NO_LEGAL_ACTION",
        "BOT_TIMEOUT",
        "MALFORMED_JSON",
        "SCHEMA_VIOLATION",
        "MATCH_ID_MISMATCH",
        "TURN_ID_MISMATCH",
        "MESSAGE_TOO_LARGE",
        "ILLEGAL_ACTION"
      ]
    },
    "faultCode": {
      "enum": [
        "BOT_TIMEOUT",
        "MALFORMED_JSON",
        "SCHEMA_VIOLATION",
        "MATCH_ID_MISMATCH",
        "TURN_ID_MISMATCH",
        "MESSAGE_TOO_LARGE",
        "ILLEGAL_ACTION",
        "BOT_SPAWN_FAILED",
        "BOT_CRASHED",
        "BOT_EOF",
        "STDERR_LIMIT_EXCEEDED",
        "RESOURCE_LIMIT_EXCEEDED",
        "SANDBOX_VIOLATION"
      ]
    },
    "faultSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recoverableTotal", "recoverableConsecutive", "lastErrorCode"],
      "properties": {
        "recoverableTotal": { "type": "integer", "minimum": 0 },
        "recoverableConsecutive": { "type": "integer", "minimum": 0 },
        "lastErrorCode": {
          "oneOf": [
            { "$ref": "#/$defs/faultCode" },
            { "type": "null" }
          ]
        }
      }
    },
    "protocolVersionV2": { "const": 2 },
    "perTurnPolicyV2": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "fixedMs"],
          "properties": {
            "mode": { "const": "FIXED" },
            "fixedMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "baseMs", "stepMs", "everyTurns", "maxMs"],
          "properties": {
            "mode": { "const": "DYNAMIC" },
            "baseMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
            "stepMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
            "everyTurns": { "type": "integer", "minimum": 1, "maximum": 10000 },
            "maxMs": { "type": "integer", "minimum": 1, "maximum": 3600000 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "NONE" }
          }
        }
      ]
    },
    "timeControlV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["startupMs", "totalBotBudgetMs", "matchWallClockMs", "perTurn"],
      "properties": {
        "startupMs": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "totalBotBudgetMs": { "type": "integer", "minimum": 1, "maximum": 3600000 },
        "matchWallClockMs": { "type": "integer", "minimum": 1, "maximum": 7200000 },
        "perTurn": { "$ref": "#/$defs/perTurnPolicyV2" }
      }
    },
    "limitsV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxTurns",
        "maxMessageBytes",
        "maxStderrBytes",
        "maxConsecutiveFaults",
        "maxTotalFaults",
        "timeControl"
      ],
      "properties": {
        "maxTurns": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maxMessageBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 },
        "maxStderrBytes": { "type": "integer", "minimum": 0, "maximum": 10485760 },
        "maxConsecutiveFaults": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maxTotalFaults": { "type": "integer", "minimum": 1, "maximum": 100 },
        "timeControl": { "$ref": "#/$defs/timeControlV2" }
      }
    },
    "turnBudgetV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["turnLimitMs", "remainingBotBudgetMs"],
      "properties": {
        "turnLimitMs": {
          "oneOf": [
            { "type": "integer", "minimum": 1, "maximum": 3600000 },
            { "type": "null" }
          ]
        },
        "remainingBotBudgetMs": { "type": "integer", "minimum": 0, "maximum": 3600000 }
      }
    },
    "initMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocolVersion",
        "matchId",
        "engineVersion",
        "side",
        "botSeed",
        "map",
        "limits"
      ],
      "properties": {
        "type": { "const": "INIT" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersionV2" },
        "matchId": { "$ref": "#/$defs/matchId" },
        "engineVersion": { "type": "string", "minLength": 1, "maxLength": 64 },
        "side": { "$ref": "#/$defs/side" },
        "botSeed": { "type": "string", "minLength": 1, "maxLength": 128 },
        "map": { "$ref": "#/$defs/mapDefinition" },
        "limits": { "$ref": "#/$defs/limitsV2" }
      }
    },
    "stateUpdateMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocolVersion",
        "matchId",
        "turnId",
        "state",
        "legalActions",
        "timeBudget"
      ],
      "properties": {
        "type": { "const": "STATE_UPDATE" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersionV2" },
        "matchId": { "$ref": "#/$defs/matchId" },
        "turnId": { "type": "integer", "minimum": 1 },
        "state": { "$ref": "#/$defs/publicGameState" },
        "legalActions": {
          "type": "array",
          "maxItems": 144,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/gameAction" }
        },
        "timeBudget": { "$ref": "#/$defs/turnBudgetV2" }
      }
    },
    "actionMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "protocolVersion", "matchId", "turnId", "action"],
      "properties": {
        "type": { "const": "ACTION" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersionV2" },
        "matchId": { "$ref": "#/$defs/matchId" },
        "turnId": { "type": "integer", "minimum": 1 },
        "action": { "$ref": "#/$defs/gameAction" }
      }
    },
    "turnResultMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocolVersion",
        "matchId",
        "turnId",
        "actorSide",
        "outcome",
        "action",
        "errorCode",
        "revision",
        "nextSide"
      ],
      "properties": {
        "type": { "const": "TURN_RESULT" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersionV2" },
        "matchId": { "$ref": "#/$defs/matchId" },
        "turnId": { "type": "integer", "minimum": 1 },
        "actorSide": { "$ref": "#/$defs/side" },
        "outcome": { "enum": ["APPLIED", "SKIPPED"] },
        "action": {
          "oneOf": [
            { "$ref": "#/$defs/gameAction" },
            { "type": "null" }
          ]
        },
        "errorCode": {
          "oneOf": [
            { "$ref": "#/$defs/turnErrorCode" },
            { "type": "null" }
          ]
        },
        "revision": { "type": "integer", "minimum": 1 },
        "nextSide": {
          "oneOf": [
            { "$ref": "#/$defs/side" },
            { "type": "null" }
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "outcome": { "const": "APPLIED" } } },
          "then": {
            "properties": {
              "action": { "$ref": "#/$defs/gameAction" },
              "errorCode": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "outcome": { "const": "SKIPPED" } } },
          "then": {
            "properties": {
              "action": { "type": "null" },
              "errorCode": { "$ref": "#/$defs/turnErrorCode" }
            }
          }
        }
      ]
    },
    "matchResultMessage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "protocolVersion",
        "matchId",
        "winnerSide",
        "reason",
        "turnCount",
        "finalStateHash",
        "faults"
      ],
      "properties": {
        "type": { "const": "MATCH_RESULT" },
        "protocolVersion": { "$ref": "#/$defs/protocolVersionV2" },
        "matchId": { "$ref": "#/$defs/matchId" },
        "winnerSide": {
          "oneOf": [
            { "$ref": "#/$defs/side" },
            { "type": "null" }
          ]
        },
        "reason": {
          "enum": ["REACHED_GOAL", "ELIMINATED_ALL_PIECES", "FORFEIT", "TURN_LIMIT"]
        },
        "turnCount": { "type": "integer", "minimum": 0 },
        "finalStateHash": { "$ref": "#/$defs/sha256" },
        "faults": {
          "type": "object",
          "additionalProperties": false,
          "required": ["X", "O"],
          "properties": {
            "X": { "$ref": "#/$defs/faultSummary" },
            "O": { "$ref": "#/$defs/faultSummary" }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "reason": { "const": "TURN_LIMIT" } } },
          "then": { "properties": { "winnerSide": { "type": "null" } } }
        },
        {
          "if": {
            "properties": {
              "reason": {
                "enum": ["REACHED_GOAL", "ELIMINATED_ALL_PIECES", "FORFEIT"]
              }
            }
          },
          "then": { "properties": { "winnerSide": { "$ref": "#/$defs/side" } } }
        }
      ]
    }
  }
}
